# Copy to .env (never commit .env) and fill in real values.

# Required
TELEGRAM_TOKEN=your-telegram-bot-token
GEMINI_API_KEY=replace-with-your-gemini-api-key

# polling = local long-polling (no public URL)
# webhook = production (Cloud Run / any HTTPS endpoint)
BOT_MODE=polling
PORT=8080

# Required in webhook mode. Telegram sends this as X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=replace-with-a-long-random-string

# Optional. If set, POST /broadcast requires header X-Broadcast-Secret.
BROADCAST_SECRET=replace-with-a-long-random-string

# Optional. Comma-separated Telegram user IDs allowed to run /status and /chats.
ADMIN_USER_IDS=

# Gemini model id. Default gemini-3.8-flash (production moved here 2026-10-20
# after gemini-1.5-flash retired and gemini-2.5-flash returned 404 for this key).
GEMINI_MODEL=gemini-3.8-flash

# Language of the generated digest (system instruction). Default: Russian.
# Aliases: ru → Russian, en → English. Other values are passed through as written.
DIGEST_LANGUAGE=Russian

# Optional comma-separated RSS URLs. Defaults to HN + The Verge.
RSS_FEEDS=https://news.ycombinator.com/rss,https://www.theverge.com/rss/index.xml

# Optional Firestore. If unset, an in-memory store is used (lost on restart).
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=(default)
# GOOGLE_CLOUD_PROJECT=

# Optional Vertex AI image generation via generateContent (inlineData PNG).
# Classic Imagen :predict (imagegeneration@006, imagen-3/4) was retired 2026-06-30 (404).
# Requires Application Default Credentials.
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
# VERTEX_ASPECT_RATIO=1:1
